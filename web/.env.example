# Primary model — any OpenAI-compatible endpoint.
# Verify the current base URL and model id in your provider's dashboard before use.
MODEL_PRIMARY_BASE_URL=
MODEL_PRIMARY_KEY=
MODEL_PRIMARY_NAME=

# Reasoning effort, for models that think before answering. Leave blank for the
# provider's default — but be aware the default is often maximum.
# Measured on a résumé review with kimi-k3: 'max' took 107s for 11 findings,
# 'low' took 33s for 12. Maximum effort bought latency and nothing else.
MODEL_PRIMARY_EFFORT=low

# Fallback, used ONLY on 429 / 5xx from the primary. Optional — leave blank to disable.
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_KEY=
MODEL_FALLBACK_NAME=
MODEL_FALLBACK_EFFORT=

# Email (Resend). Needs a verified domain before it can send to anyone but you.
# Leave blank until then: password-reset links are printed by `npm run reset-link` instead.
RESEND_API_KEY=
# Sender, on the verified domain, e.g. "Job Search Kit <noreply@mail.yourdomain.com>"
EMAIL_FROM=
